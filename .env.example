# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://continuum:continuum@localhost:5432/continuum?schema=public"

# Redis (cache + BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# AI provider: "anthropic" (Claude, paid) or "openai" (any OpenAI-compatible endpoint, incl. free tiers)
AI_PROVIDER="anthropic"

# --- Free option (AI_PROVIDER="openai"), example: Google Gemini via AI Studio key ---
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_API_KEY="your-ai-studio-key"
# LLM_MODEL="check the current free model name in AI Studio"
# Other OpenAI-compatible options: Groq https://api.groq.com/openai/v1 , Ollama (local) http://localhost:11434/v1

# --- Anthropic option (AI_PROVIDER="anthropic") ---
CLAUDE_API_KEY="sk-ant-xxxxx"
CLAUDE_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS=8000
AI_DAILY_RATE_LIMIT=50
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Rate limiting (global, requests per minute per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Google Calendar integration (optional — feature shows "belum dikonfigurasi" without these)
FRONTEND_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"
# Encrypts stored OAuth tokens at rest; falls back to JWT_ACCESS_SECRET if unset
GOOGLE_TOKEN_ENCRYPTION_KEY=""
