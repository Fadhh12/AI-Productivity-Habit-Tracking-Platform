# Base URL of the Continuum backend API.
# Keep this as localhost:3000 for normal browser use on this machine.
# Only override it with your computer's LAN IP (e.g. http://192.168.1.23:3000)
# when opening the app from a phone on the same Wi-Fi — and remember that IP
# changes whenever you reconnect to a different network. A stale LAN IP here
# makes every API call hang silently (login/register look "broken" with no
# error), so switch it back to localhost:3000 once you're done phone-testing.
NEXT_PUBLIC_API_URL=http://localhost:3000
